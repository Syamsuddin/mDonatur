{
  "app": {
    "name": "mDonator",
    "description": "Aplikasi Android (Flutter) untuk operator aplikasi Donatur Yayasan Ibnu Atha'illah: input sumbangan, tambah donatur, Input Saya, rekap, ganti password; semua aturan bisnis di server lewat API JSON",
    "type": "greenfield"
  },
  "confirmed_at": "2026-10-10T00:00:00+08:00",
  "sources": {
    "dosir": "DOSIR_MDONATOR.md (bahan asal, bukan bagian paket; bila beda dengan docs/, docs menang)",
    "contract": "API_CONTRACT.md v0.1.0 (rumah tunggal alamat, aksi, payload, kode galat)",
    "server_plan": "../UPDATE_PLAN.md Fase 12 + ../CLAUDE.md (sisi server, di luar paket)"
  },
  "requirements": {
    "goal": "Operator mencatat sumbangan dari HP dengan aturan yang sama dengan web",
    "success_metric": "≥80% sumbangan baru tercatat lewat mobile dalam 3 bulan (audit.log via=mobile); ≤15 detik per input tanpa konfirmasi [ASUMSI A1]",
    "features": [
      {
        "name": "F1 Masuk dan keluar (token)",
        "priority": "mvp"
      },
      {
        "name": "F2 Pengaturan alamat server",
        "priority": "mvp"
      },
      {
        "name": "F3 Cek dan cari donatur",
        "priority": "mvp"
      },
      {
        "name": "F4 Input sumbangan",
        "priority": "mvp"
      },
      {
        "name": "F5 Tambah donatur + sumbangan pertama",
        "priority": "mvp"
      },
      {
        "name": "F6 Input Saya + ubah nominal",
        "priority": "mvp"
      },
      {
        "name": "F7 Rekap hari/minggu/bulan x saya/semua",
        "priority": "mvp"
      },
      {
        "name": "F8 Ganti password",
        "priority": "mvp"
      },
      {
        "name": "N1 Pindai QR kartu donatur",
        "priority": "later"
      },
      {
        "name": "N2 Bukti sumbangan via wa.me",
        "priority": "later"
      },
      {
        "name": "N3 iOS",
        "priority": "later"
      }
    ],
    "out_of_scope": [
      "hapus donasi",
      "Note/Input Khusus",
      "ubah/hapus donatur dan kelola pengguna",
      "daftar sumbangan lengkap, grafik, rekap tahunan",
      "mode offline",
      "aplikasi untuk donatur",
      "perubahan skema DB",
      "distribusi APK dan langkah server produksi",
      "kode server (milik repo root)"
    ],
    "roles": [
      {
        "name": "operator",
        "can": [
          "F1-F8",
          "ubah milik sendiri hari ini (K6)"
        ],
        "cannot": [
          "melihat Note n",
          "hapus",
          "ubah milik orang lain/kemarin"
        ]
      },
      {
        "name": "admin",
        "can": [
          "F1-F8",
          "melihat baris note_n",
          "ubah milik sendiri tanggal apa pun [ASUMSI A19]"
        ],
        "cannot": [
          "ubah Note",
          "hapus",
          "Input Khusus di mobile"
        ]
      }
    ],
    "processes": [
      {
        "name": "P1 Masuk",
        "happy_path": "login → token → konfigurasi → tab Input",
        "failure": "login_gagal, login_terkunci, api_mati, jaringan, versi"
      },
      {
        "name": "P2 Input sumbangan",
        "happy_path": "nomor → Cek → Jumlah → Simpan → kartu hasil",
        "failure": "tidak_valid, tidak_ada, perlu_konfirmasi, jaringan (kunci sama), 401"
      },
      {
        "name": "P3 Tambah donatur",
        "happy_path": "isian → nama mirip → Simpan → Nomor Register",
        "failure": "tidak_valid, donatur_sudah_ada, perlu_konfirmasi"
      },
      {
        "name": "P4 Input Saya dan ubah",
        "happy_path": "daftar tanggal → ketuk boleh_ubah → ubah → simpan",
        "failure": "tidak_berhak, tidak_ada, perlu_konfirmasi, tidak_valid"
      },
      {
        "name": "P5 Rekap",
        "happy_path": "periode x cakupan → geser periode",
        "failure": "kosong, galat"
      },
      {
        "name": "P6 Ganti password",
        "happy_path": "lama/baru/ulang → token baru",
        "failure": "fitur_belum_tersedia, login_terkunci, tidak_valid, putus koneksi"
      },
      {
        "name": "P7 Pencabutan akses",
        "happy_path": "-",
        "failure": "401 → Masuk, isian dipulihkan"
      }
    ],
